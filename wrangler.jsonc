{
  "name": "yagiri-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // 計測用の D1。database_id は書かない(初回のデプロイで wrangler が自動で作って紐づける)
  "d1_databases": [{ "binding": "DB" }],
  "env": {
    "staging": {
      "name": "yagiri-web-staging",
      "compatibility_date": "2026-08-28",
      "main": "worker/index.js",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [{ "binding": "DB" }]
    }
  }
}
