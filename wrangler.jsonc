{
  "name": "yagiri-web",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "name": "yagiri-web-staging",
      "compatibility_date": "2026-08-28",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
